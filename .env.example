# ============================================================
# MARGMOCOTH CBT - Environment Variables
# Margaret Mosunmola College of Health Science and Technology, Owo
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- MongoDB (REQUIRED) ----------------------------------------
# Use a NEW database for this school, e.g. .../margmocoth_cbt
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/margmocoth_cbt?retryWrites=true&w=majority

# --- Admin account (created on first boot) ---------------------
ADMIN_EMAIL=Margmocoth.examinationsmedia@gmail.com
# If ADMIN_PASSWORD is empty, a random password is generated and printed ONCE in the server log.
ADMIN_PASSWORD=

# --- Cloudinary (face capture storage) -------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Session ---------------------------------------------------
# A long random string used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# --- Server ----------------------------------------------------
PORT=3000
# Public address of the deployed site (used in push notification links)
APP_URL=https://cbt.yourdomain.edu.ng
