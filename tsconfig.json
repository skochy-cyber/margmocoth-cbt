{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["dom", "dom.iterable", "es2022"],
    "skipLibCheck": true
  },
  "include": ["server.js", "public/**/*.js"],
  "exclude": ["node_modules", "tests"]
}
